# Set this before creating the first account to grant it administrator privileges.
SITHUB_ADMIN_USERNAME=your-admin-username

# Optional persistent storage path. Defaults to ./sithub/data
# SITHUB_DATA_DIR=./data/sithub

# Scratch WWW API endpoints (defaults are defined in webpack.config.js)
# API_HOST=https://api.scratch.mit.edu
# PROJECT_HOST=https://projects.scratch.mit.edu

# Production cookie behavior
# NODE_ENV=production
# PORT=8333
